# ==================== U-FLEX POS Backend ENV ====================
# Bu shablon. Haqiqiy qiymatlarni Railway "Variables" bo'limidan kiriting.
# .env faylga real maxfiy kalitlarni yozmang (git tarixiga tushmasligi uchun).

# --- Server ---
PORT=8080
NODE_ENV=production

# --- Auth (JWT) ---
# Kuchli, tasodifiy maxfiy kalit kiriting (masalan: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
JWT_EXPIRE=30d

# --- PostgreSQL (Railway) ---
# Railway Postgres "Connect" → connection string
PG_CONNECTION=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# --- Eskiz SMS ---
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Railway Bucket (S3-mos) — mahsulot rasmlari shu yerda saqlanadi ---
# Bucket "Variables"/"Connect" bo'limidan oling. Sozlanmasa rasm yuklash o'chiq bo'ladi.
S3_ENDPOINT=
S3_BUCKET=orderly-tortellini
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# MinIO/Tigris uchun odatda true
S3_FORCE_PATH_STYLE=true
# Bucket public bo'lsa, public bazaviy URL (ixtiyoriy). Bo'sh bo'lsa backend proxy ishlatadi.
S3_PUBLIC_URL=

# --- DB backup (bucket'ga JSON) ---
DB_BACKUP_ENABLED=true
DB_BACKUP_CRON=0 3 * * *
DB_BACKUP_TZ=Asia/Tashkent
DB_BACKUP_PREFIX=backups
