# ============================================================
# UFLEX POS — Backend muhit o'zgaruvchilari (NAMUNA)
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring.
# Lokal ishga tushirish:  cp .env.example .env  →  npm run dev
# ============================================================

# --- DATABASE (PostgreSQL) ---
# Lokal: o'z Postgres'ingiz. Server: Railway public connection string.
PG_CONNECTION="postgresql://username:password@localhost:5432/database_name"
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# --- SERVER ---
PORT="8080"
NODE_ENV="development"               # serverda: production

# --- CORS ---
# Bo'sh qoldiring => barcha originlarga ruxsat (lokal/kassa ilovasi uchun qulay).
# Productionda cheklash uchun ruxsat etilgan domenlarni vergul bilan kiriting:
# ALLOWED_ORIGINS="https://admin.uflex.uz,https://uflex-pos-admin.netlify.app"
ALLOWED_ORIGINS=""

# --- JWT ---
JWT_SECRET="bu-yerga-uzun-tasodifiy-maxfiy-kalit-qoying"
JWT_EXPIRE="30d"

# --- ESKIZ SMS ---
ESKIZ_BASE_URL="https://notify.eskiz.uz"
ESKIZ_EMAIL="your-eskiz-email@example.com"
ESKIZ_FROM="4546"
ESKIZ_PASSWORD="your-eskiz-password"
SMS_ENABLED="false"

# --- DATABASE BACKUP (S3 bucket'ga) ---
DB_BACKUP_ENABLED="false"
DB_BACKUP_CRON="0 2 * * *"
DB_BACKUP_PREFIX="pos-system-backup"
DB_BACKUP_TZ="Asia/Tashkent"

# --- S3 STORAGE (rasm saqlash; lokal uchun MinIO, serverda Railway bucket) ---
S3_BUCKET="your-bucket-name"
S3_REGION="us-west-2"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_URL="http://localhost:9000"
