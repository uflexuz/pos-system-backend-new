{
  "name": "uflex-pos-backend",
  "version": "1.0.0",
  "description": "UFLEX POS backend",
  "main": "server.js",
  "scripts": {
    "prestart": "prisma generate",
    "start": "node bootstrap.js",
    "predev": "prisma generate",
    "dev": "nodemon server.js",
    "seed:ready-made-products": "node seeds/importReadyMadeProducts.js",
    "seed:tea-products": "node seeds/seedTeaProducts.js",
    "seed:cost-prices": "node seeds/updateProductCostPrices.js",
    "fix:product-units": "node seeds/fixProductUnits.js",
    "seed:customers:csv": "node seeds/seedCustomersFromCsv.js ../mijoz.csv",
    "seed:sms:csv": "node seeds/seedSmsFromCsv.js",
    "seed:catalog": "node seeds/seedUniversalCatalog.js",
    "seed:mock": "node seeds/seedMockData.js",
    "seed:admin": "node seeds/seedAdmin.js",
    "reset:data": "node seeds/resetData.js",
    "reset:data:confirm": "RESET_CONFIRM=true node seeds/resetData.js",
    "backup:now": "node -e \"require('./utils/dbBackupScheduler').runBackup()\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "axios": "^1.15.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
