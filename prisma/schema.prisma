// Prisma Schema - UFLEX POS Backend
// PostgreSQL structured tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== MODELS ====================

model Admin {
  @@map("admins")

  id        String    @id
  fullName  String?   @map("full_name")
  phone     String?   @unique
  password  String?
  role      String    @default("admin")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  managedBranches Branch[]      @relation("BranchManager")
  transactions    Transaction[] @relation("TransactionCreator")
}

model Branch {
  @@map("branches")

  id        String   @id
  name      String?
  address   String?
  phone     String?
  managerId String?  @map("manager")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  manager     Admin?      @relation("BranchManager", fields: [managerId], references: [id])
  inventories Inventory[]
  sales       Sale[]
  workers     Worker[]
}

model Category {
  @@map("categories")

  id        String   @id
  name      String?
  key       String?  @unique
  isActive  Boolean  @default(true) @map("is_active")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  products Product[]
}

model Product {
  @@map("products")

  id                  String   @id
  name                String?
  categoryKey         String?  @map("category")
  image               String?
  telegramMessageId   String?  @map("telegram_message_id")
  sku                 String?  @unique
  unit                String?
  salePrice           Decimal? @map("sale_price") @db.Decimal
  costPrice           Decimal? @map("cost_price") @db.Decimal

  // Relations
  category            Category?       @relation(fields: [categoryKey], references: [key])
  inventoryItems      InventoryItem[]
  saleItems           SaleItem[]
}

model Inventory {
  @@map("inventories")

  id        String   @id
  branchId  String   @map("branch")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  branch Branch          @relation(fields: [branchId], references: [id])
  items  InventoryItem[]
}

model InventoryItem {
  @@map("inventory_items")
  @@unique([inventoryId, productId])

  id          String   @id @default(cuid())
  inventoryId String   @map("inventory_id")
  productId   String   @map("product_id")
  quantity    Decimal  @default(0) @db.Decimal
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  inventory Inventory @relation(fields: [inventoryId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
}

model Worker {
  @@map("workers")

  id        String   @id
  fullName  String?  @map("full_name")
  phone     String?
  password  String?
  balance   Decimal  @default(0) @db.Decimal
  role      String?
  branchId  String?  @map("branch")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  branch     Branch? @relation(fields: [branchId], references: [id])
  salesAsSeller Sale[] @relation("SaleSeller")
  salesAsWaiter Sale[] @relation("SaleWaiter")
}

model Customer {
  @@map("customers")

  id          String   @id
  name        String?  @map("full_name")
  phoneNumber String?  @map("phone")
  address     String?
  notes       String?  @map("note")
  balance     Decimal  @default(0) @db.Decimal
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  sales              Sale[]
  ledgerTransactions CustomerLedgerTransaction[]
  smsMessages        SmsMessage[]
}

model SmsTemplate {
  @@map("sms_templates")
  @@index([isActive])

  id          String   @id
  name        String   @unique
  body        String
  variables   Json     @default("[]")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  messages SmsMessage[]
}

model SmsMessage {
  @@map("sms_messages")
  @@index([status])
  @@index([category])
  @@index([recipientPhone])
  @@index([recipientCustomerId])
  @@index([senderAdminId])
  @@index([templateId])
  @@index([createdAt])

  id                  String    @id
  templateId          String?   @map("template_id")
  recipientCustomerId String?   @map("recipient_customer_id")
  recipientPhone      String    @map("recipient_phone")
  body                String
  variables           Json      @default("{}")
  eskizMessageId      String?   @unique @map("eskiz_message_id")
  eskizStatusRaw      String?   @map("eskiz_status_raw")
  status              String    @default("pending")
  category            String    @default("manual")
  partsCount          Int?      @map("parts_count")
  cost                Decimal?  @db.Decimal
  errorMessage        String?   @map("error_message")
  senderAdminId       String?   @map("sender_admin_id")
  sentAt              DateTime? @map("sent_at") @db.Timestamptz
  statusCheckedAt     DateTime? @map("status_checked_at") @db.Timestamptz
  deliveredAt         DateTime? @map("delivered_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  template          SmsTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipientCustomer Customer?    @relation(fields: [recipientCustomerId], references: [id], onDelete: SetNull)
}

model CustomerLedgerTransaction {
  @@map("customer_ledger_transactions")
  @@index([customerId])
  @@index([transactionDate])

  id              String   @id
  customerId      String   @map("customer_id")
  type            String
  amount          Decimal  @db.Decimal
  notes           String?
  balanceBefore   Decimal  @default(0) @map("balance_before") @db.Decimal
  balanceAfter    Decimal  @default(0) @map("balance_after") @db.Decimal
  transactionDate DateTime @default(now()) @map("transaction_date") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Sale {
  @@map("sales")

  id             String    @id
  saleNumber     String?   @map("sale_number")
  saleDate       DateTime? @map("sale_date") @db.Timestamptz
  branchId       String?   @map("branch")
  sellerId       String?   @map("seller")
  waiterId       String?   @map("waiter")
  subtotal       Decimal?  @db.Decimal
  total          Decimal?  @db.Decimal
  discount       Decimal?  @default(0) @db.Decimal
  discountType   String?   @map("discount_type")
  tax            Boolean   @default(false)
  taxAmount      Decimal?  @default(0) @map("tax_amount") @db.Decimal
  taxPercent     Decimal?  @default(0) @map("tax_percent") @db.Decimal
  paymentType    String?   @map("payment_type")
  paymentDetails Json?     @map("payment_details")
  status         String    @default("completed")
  transactionId  String?   @map("transaction")
  notes          String?
  customerId     String?   @map("customer")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  branch      Branch?          @relation(fields: [branchId], references: [id])
  seller      Worker?          @relation("SaleSeller", fields: [sellerId], references: [id])
  waiterRef   Worker?          @relation("SaleWaiter", fields: [waiterId], references: [id])
  customer    Customer?        @relation(fields: [customerId], references: [id])
  transaction Transaction?     @relation(fields: [transactionId], references: [id])
  items       SaleItem[]
}

model SaleItem {
  @@map("sale_items")

  id          String  @id @default(cuid())
  saleId      String  @map("sale_id")
  productId   String  @map("product_id")
  productName String? @map("product_name")
  quantity    Decimal @default(1) @db.Decimal
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal
  totalPrice  Decimal @default(0) @map("total_price") @db.Decimal
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Transaction {
  @@map("transactions")

  id          String   @id
  type        String?
  category    String?
  amount      Decimal  @default(0) @db.Decimal
  paymentType String?  @map("payment_type")
  description String?
  status      String   @default("completed")
  createdById String?  @map("created_by")
  worker      Json?
  inventory   Json?
  inventories Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  createdBy Admin? @relation("TransactionCreator", fields: [createdById], references: [id])
  sales     Sale[]
}
